# =========================================================================
# AI Support Assistant Configuration
# =========================================================================

# Database Connection (MongoDB local or Mongo Atlas cloud URL)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_support_assistant

# Server Listening Port (Default: 5000)
PORT=5000

# Gemini API Key (Required for active AI replies. Get yours at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
